# Dokploy / Proxmox deployment template
# Copy this file to a real .env file in the Dokploy project settings
# and replace all placeholder values before deploying.

POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_NEON_PASSWORD
DATABASE_URL=postgresql://neondb_owner:REPLACE_WITH_YOUR_NEON_PASSWORD@ep-solitary-dew-aoa3ecy7.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Public URL of the web app, used by the API CORS configuration.
WEB_ORIGIN=https://ndev.galmi.org

# Must be at least 32 characters long.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Separate bootstrap key for the platform admin creation flow.
PLATFORM_ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_A_SEPARATE_RANDOM_KEY_AT_LEAST_32_CHARACTERS

# Optional: keep only if you want to allow multiple origins.
# WEB_ORIGIN=https://example.com,https://www.example.com
