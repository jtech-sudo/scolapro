{
  "name": "csp-nouvel-espoir",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace @csp/api",
    "build:api": "npm run build --workspace @csp/api",
    "dev:web": "npm run dev --workspace @csp/web",
    "build:web": "npm run build --workspace @csp/web",
    "build": "npm run build --workspace @csp/api && npm run build --workspace @csp/web",
    "typecheck": "npm run typecheck --workspace @csp/api && npm run typecheck --workspace @csp/web",
    "test": "npm run test --workspace @csp/api",
    "test:integration": "npm run test:integration --workspace @csp/api",
    "db:generate": "npm run prisma:generate --workspace @csp/api",
    "db:push": "npm run prisma:db:push --workspace @csp/api",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @csp/api",
    "admin:reset-platform-password": "node script/reset-platform-admin-password.cjs"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
